{
  "luci-app-proxy-box": {
    "description": "Grant access to Proxy Box settings",
    "read": {
      "uci": ["proxy_box"],
      "ubus": {
        "file": ["list", "read", "stat"]
      }
    },
    "write": {
      "uci": ["proxy_box"],
      "ubus": {
        "file": ["list", "read", "write", "stat", "exec"]
      }
    }
  }
}
