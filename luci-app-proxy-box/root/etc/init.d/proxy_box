#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

GENERATOR=/usr/libexec/proxy-box/generate.lua
DEFAULT_PROG=/usr/bin/sing-box
DEFAULT_CONFIG=/etc/proxy-box/config.json

start_service() {
	[ -x "$GENERATOR" ] || {
		logger -t proxy_box "config generator missing: $GENERATOR"
		return 1
	}
	"$GENERATOR" || {
		logger -t proxy_box "config generation failed"
		return 1
	}

	config_load proxy_box
	config_get_bool enabled main enabled 0
	config_get core_path main core_path "$DEFAULT_PROG"
	config_get config_path main config_path "$DEFAULT_CONFIG"

	[ "$enabled" = "1" ] || return 0

	[ -x "$core_path" ] || {
		logger -t proxy_box "enabled but core is not executable: $core_path"
		return 1
	}
	[ -r "$config_path" ] || {
		logger -t proxy_box "enabled but config is not readable: $config_path"
		return 1
	}

	"$core_path" check -c "$config_path" || {
		logger -t proxy_box "sing-box config check failed"
		return 1
	}

	procd_open_instance
	procd_set_param command "$core_path" run -c "$config_path"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

reload_service() {
	stop
	start
}

service_triggers() {
	procd_add_reload_trigger proxy_box
}
